   },
   "description": "Search the skill tree (BM25), optionally scoped to a coordinate subtree (e.g. '0.1'). SkillTree's search hands a\nquery's words to FTS5 unquoted, so it raises on a query with no word and on an operator word (`NOT`, `AND`); this\ndoor sends it the query's words alone, lowercased — FTS5's operators are capitals and its index folds case, so the\nwords match as before — and answers a query with no word with nothing.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "limit": {
      "default": 10,
      "type": "integer"
     },
     "query": {
      "type": "string"
     },
     "root_dir": {
      "type": "string"
     },
     "scope_coord": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     }
    },
    "required": [
     "root_dir",
     "query"
    ],
    "type": "object"
   },
   "name": "si_search",
   "outputSchema": {
    "properties": {
     "result": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "result"
    ],
    "type": "object",
    "x-fastmcp-wrap-result": true
   },
